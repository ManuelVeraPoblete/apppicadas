# App
PORT=3000
NODE_ENV=development
# En producción: lista de orígenes separados por coma. Ej: https://miapp.cl,https://admin.miapp.cl
CORS_ORIGINS=http://localhost:3000

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=tu_password
DB_NAME=picacerca_db

# Cifrado de tokens sensibles (AES-256-GCM)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=genera_una_clave_con_el_comando_de_arriba

# JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tu_refresh_secret_muy_seguro_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Storage (local | cloudinary)
STORAGE_TYPE=local
# HOST: IP de tu máquina en la LAN (para imágenes desde dispositivo físico)
HOST=192.168.x.x
# UPLOADS_BASE_URL sobreescribe HOST+PORT si se define explícitamente
# UPLOADS_BASE_URL=http://192.168.x.x:3000/uploads

# Meta / Instagram OAuth
META_APP_ID=tu_meta_app_id
META_APP_SECRET=tu_meta_app_secret
META_REDIRECT_URI=https://tu-dominio.com/instagram/callback
