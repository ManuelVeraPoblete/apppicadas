# App
PORT=3000
NODE_ENV=development
# En producción: lista de orígenes separados por coma. Ej: https://miapp.cl,https://admin.miapp.cl
CORS_ORIGINS=http://localhost:3000

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=tu_password
DB_NAME=picacerca_db

# Cifrado de tokens sensibles (AES-256-GCM)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=genera_una_clave_con_el_comando_de_arriba

# JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tu_refresh_secret_muy_seguro_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
